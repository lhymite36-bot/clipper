# Optional. Clipper works with no keys (local loudness/keyword heuristic).
# Never commit a filled copy of this file. Keys are never printed in logs or the UI.

# Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free Groq key: https://console.groq.com/keys
GROQ_API_KEY=

# Buffer auto-post (default). Buffer → Settings → API.
BUFFER_API_KEY=
# Fine-grained GitHub token with Contents read/write on a public repo used for MP4 URLs
# (e.g. lhymite36-bot/qb-media). Same idea as Voice to Short.
CLIPPER_GITHUB_TOKEN=

# Optional Pixabay Music (free key). Clipper still never rips audio from YouTube videos.
# PIXABAY_API_KEY=

# Optional direct YouTube Data API upload (draft/private by default).
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=

# Optional overrides
# CLIPPER_MODEL_DIR=
# CLIPPER_COMPUTE_TYPE=int8
# CLIPPER_HOME=
